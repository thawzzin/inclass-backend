NODE_ENV=development
PORT=4000

DATABASE_URL="postgresql://USER:PASSWORD@POOLER_HOST/DB_NAME?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST/DB_NAME?sslmode=require"
# TEST_DATABASE_URL="postgresql://USER:PASSWORD@TEST_HOST/TEST_DB_NAME?sslmode=require"

JWT_ACCESS_SECRET="replace-with-at-least-32-random-characters"
CSRF_SECRET="replace-with-a-different-at-least-32-random-characters"
ACCESS_TOKEN_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN_DAYS=7

FRONTEND_URL="http://localhost:4001"
ALLOW_ORIGINS="http://localhost:4001"
LOG_LEVEL=info
TRUST_PROXY=false

SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="replace-with-development-password"
